PORT=4000

# Postgres connection — the team shares one hosted instance; ask
# whoever set it up for the real connection string. This placeholder
# is just so the app has something to try (and fail clearly) without
# a .env configured.
DATABASE_URL=postgres://localhost:5432/careconnect

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1h

# Email (reminders, confirmations, password reset)
EMAIL_FROM=no-reply@careconnect.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
